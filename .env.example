# Copy to `SCRIPT_DIR/.env` or point SYNC_ENV_FILE here.
# Colon-separated paths are relative to each .cursor root (rules/foo.mdc).
# Export the same variables in your shell before running the script to override file values.

# Skip copying these from Windows into WSL (Windows-only rules stay on Windows).
# SYNC_IGNORE_WIN_TO_WSL=rules/powershell.mdc:rules/windows-grep.mdc

# Skip copying these from WSL into Windows.
# SYNC_IGNORE_WSL_TO_WIN=
