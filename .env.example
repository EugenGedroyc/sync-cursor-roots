# Copy to `SCRIPT_DIR/.env` or point SYNC_ENV_FILE here.
# SYNC_IGNORE_* entries are repo-relative under each .cursor root (e.g. rules/foo.mdc).
# Export the same variables in your shell before running the script to override file values.

# Required for a real run unless you pass --root-2:
# CURSOR_ROOT_2=/path/to/other/.cursor

# Skip copying these from root 2 into root 1 (paths that should stay only under root 2).
# Multiple paths: separate with colon (:), not commas — e.g. rules/a.mdc:rules/b.mdc
# SYNC_IGNORE_2_TO_1=rules/example.mdc

# Skip copying these from root 1 into root 2. Same format: colon-separated if you list several.
# SYNC_IGNORE_1_TO_2=

# Project pairs. One name|side1|side2 entry per line, or several separated by ';'.
# side1 and side2 are the project's .cursor directory on each side (side 2 may live in a
# settings repo and does not have to be named .cursor). Blank lines and # comments are ignored.
# Ignore keys for these files are projects/<name>/<rel>, e.g. projects/my-app/rules/x.mdc.
#
# Git Bash accepts C:/..., /c/..., and backslashes:
# SYNC_PROJECTS='
# my-app|C:/Users/you/code/my-app/.cursor|D:/cursor-config/projects/my-app
# web|/c/Users/you/code/web/.cursor|D:/cursor-config/projects/web
# '
# SYNC_PROJECTS=

# Items synced inside each project pair. Trailing slash (or a bare name) = directory; else a file.
# Default when unset: rules/,skills/,commands/,agents/,mcp.json,hooks.json,BUGBOT.md
# SYNC_PROJECT_ITEMS=rules/,skills/,commands/,agents/,mcp.json,hooks.json,BUGBOT.md

# Opt-in additions to the global roots sync. Default empty (commands/, mcp.json, hooks.json stay out).
# SYNC_EXTRA_ITEMS=commands/,mcp.json,hooks.json
